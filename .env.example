# ============================================================
# KVM HA Cluster — Host Configuration
# ============================================================
# Copy this to .env and edit for YOUR host
#
#   cp .env.example .env
#   nano .env
#
# .env is gitignored — never commit real values
# ============================================================

# ------------------------------------------------------------
# HOST IDENTITY  (এই হোস্টের পরিচয়)
# ------------------------------------------------------------
# Unique name for this host (e.g., host-a, host-b, host-c)
HOST_NAME="host-c"

# This host's IP address on the physical LAN
HOST_IP="10.0.0.12"

# This host's physical NIC MAC address
# Find with: cat /sys/class/net/enp3s0/address
HOST_MAC="aa:bb:cc:dd:ee:03"

# Physical NIC interface name
# Find with: ip -br link
PHYS_IFACE="enp3s0"

# Old NetworkManager connection name (before bridge)
# Find with: nmcli -t -f NAME,DEVICE connection show | grep enp3s0
# Example: "Wired connection 1"
OLD_CONN="Wired connection 1"

# Bridge interface name (usually unchanged)
BRIDGE_IFACE="br0"

# ------------------------------------------------------------
# NETWORK  (সবার জন্য একই — সব হোস্টে কপি করুন)
# ------------------------------------------------------------
GATEWAY_IP="10.0.0.1"
NETWORK_CIDR="24"
DNS_SERVERS="8.8.8.8,8.8.4.4"

# ------------------------------------------------------------
# VM DEFAULTS  (সব VM এর জন্য)
# ------------------------------------------------------------
VM_USER="vm"
VM_PASSWORD="changeme"

VM_VCPU=2
VM_RAM_MB=4096
VM_DISK_SIZE="20G"

# ------------------------------------------------------------
# CLOUD IMAGE
# ------------------------------------------------------------
CLOUD_IMAGE_URL="https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"
CLOUD_IMAGE_PATH="/var/lib/libvirt/images/ubuntu-24.04-cloudimg-amd64.img"
IMAGE_DIR="/var/lib/libvirt/images"

# ------------------------------------------------------------
# VMs ON THIS HOST  (এই হোস্টে কোন VM গুলো থাকবে)
# ------------------------------------------------------------
# Format: space-separated list of "name:ip"
# প্রতিটা হোস্টে আলাদা — শুধু এই হোস্টের VM গুলো
#
# Host C (এই হোস্ট): VM5, VM6
VMS="vm5:10.0.0.205 vm6:10.0.0.206"

# Reference — Other hosts in the cluster (for verification only)
CLUSTER_HOSTS="10.0.0.10:host-a 10.0.0.11:host-b"
CLUSTER_VMS="10.0.0.201:vm1 10.0.0.202:vm2 10.0.0.203:vm3 10.0.0.204:vm4"
